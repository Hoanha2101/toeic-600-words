{
  "buildCommand": "pnpm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/api/index.py?__path=assets/$1"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/api/index.py?__path=$1"
    }
  ]
}
