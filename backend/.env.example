# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
# Note: SUPABASE_SERVICE_ROLE_KEY is secret and should only be used on the backend
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Supabase JWT Secret (found in Supabase Dashboard > Project Settings > API > JWT Settings > JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Server Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
HOST=0.0.0.0

# Optional: set to true to force mock in-memory DB (useful for offline testing without Supabase)
MOCK_DB=false
